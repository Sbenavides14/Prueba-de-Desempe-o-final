# Copio este archivo a ".env" y reemplazo cada valor por uno real.
# Nunca subo mi ".env" real al repositorio.

# --- Postgres: usuario superusuario, solo para crear las bases y los roles iniciales ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-esta-clave

# --- Mi única base de datos: separo raw/staging/curated/app/airflow por esquemas, no por bases ---
APP_DB_NAME=sismowatch

# --- Metadata interna de Airflow (no toca mis datos de negocio) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar-esta-clave
# Genero estas dos claves con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# --- Mi usuario admin de la interfaz de Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar-esta-clave
AIRFLOW_ADMIN_EMAIL=admin@sismowatch.local

# --- Rol de mínimo privilegio: solo puede insertar en raw ---
INGESTOR_DB_USER=ingestor
INGESTOR_DB_PASSWORD=cambiar-esta-clave

# --- Rol de mínimo privilegio: lee raw, escribe staging/curated/eventos_rechazados ---
TRANSFORMER_DB_USER=transformer
TRANSFORMER_DB_PASSWORD=cambiar-esta-clave

# --- Rol de mínimo privilegio: solo lee curated, lo usa mi api ---
READER_DB_USER=reader
READER_DB_PASSWORD=cambiar-esta-clave

# --- Mi modelo de IA local, servido por Ollama ---
OLLAMA_MODEL=llama3.1:8b

# --- A dónde aviso cuando una tarea de Airflow falla (webhook genérico, ej. Discord o webhook.site) ---
ALERT_WEBHOOK_URL=

# --- Firma mis tokens de sesión en la api ---
JWT_SECRET=cambiar-esta-clave

# --- Credenciales del usuario admin de mi plataforma web (se siembran, nunca van en código) ---
APP_ADMIN_EMAIL=admin@sismowatch.local
APP_ADMIN_PASSWORD=cambiar-esta-clave
COMPOSE_PROJECT_NAME=sismowatch
